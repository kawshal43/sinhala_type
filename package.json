{
  "name": "autocap",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "node scripts/run-worker.mjs",
    "install:cep": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Install-AutoCap.ps1",
    "package:cep": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Package-AutoCap.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "ffmpeg-static": "^5.3.0",
    "sinhala-unicode-coverter": "^1.0.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
