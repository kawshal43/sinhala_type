{
  "manifestVersion": 5,
  "id": "com.autocap.premiere",
  "name": "AutoCap",
  "version": "1.3.1",
  "main": "index.html",
  "host": [{ "app": "premierepro", "minVersion": "25.6.0" }],
  "requiredPermissions": { "clipboard": "readAndWrite" },
  "entrypoints": [{
    "type": "panel",
    "id": "autocap.panel",
    "label": { "default": "AutoCap" },
    "minimumSize": { "width": 300, "height": 420 },
    "preferredDockedSize": { "width": 360, "height": 620 },
    "preferredFloatingSize": { "width": 380, "height": 680 }
  }]
}
